# ─── Directus (Backend API + Auth) ──────────────────
VITE_DIRECTUS_URL=/api/directus

# ─── Service URLs (Nginx Reverse Proxy) ─────────────
VITE_N8N_URL=/api/n8n
VITE_ESPOCRM_URL=/api/espocrm
VITE_PORTAINER_URL=/api/portainer
VITE_GLANCES_URL=/api/glances
VITE_MAUTIC_URL=/api/mautic
VITE_MEMOS_URL=/api/memos
VITE_CHATWOOT_URL=/api/chatwoot

# ─── External URLs (iFrame / direct links) ──────────
VITE_APPSMITH_URL=https://dashboard.tinhgon.com
VITE_HOMEPAGE_URL=https://home.tinhgon.com
VITE_DATABASEMENT_URL=https://db.tinhgon.com
VITE_EVISA_BACKEND_URL=https://backend.evisavietnamservice.com

# ─── Feature Flags ──────────────────────────────────
VITE_ENABLE_AUTH=true
VITE_ENABLE_CRM_SYNC=true
VITE_ENABLE_N8N_PANEL=true
VITE_ENABLE_MONITORING=true
